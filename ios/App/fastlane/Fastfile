default_platform(:ios)

platform :ios do

  # Log in to App Store Connect with an API key when one is configured, instead
  # of the Apple ID. Apple ID login needs 2FA and breaks whenever Apple changes
  # its sign-in service (Sep 2026: "Service key is empty", then "Access
  # forbidden"); the API key has neither problem. Set in ~/.zshrc, never in
  # the repo:
  #   APP_STORE_CONNECT_API_KEY_KEY_ID, APP_STORE_CONNECT_API_KEY_ISSUER_ID,
  #   APP_STORE_CONNECT_API_KEY_KEY_FILEPATH (path to the downloaded .p8)
  # app_store_connect_api_key reads exactly these; every upload action below
  # then picks the key up from the lane context.
  before_all do
    app_store_connect_api_key if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
  end

  desc "Build and upload to TestFlight"
  lane :beta do |options|
    # Increment build number automatically
    increment_build_number(
      xcodeproj: "App.xcodeproj"
    )

    # Build the app
    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      clean: true
    )

    # Upload to TestFlight and distribute to external testers
    # (Internal testers automatically see all builds)
    upload_to_testflight(
      skip_waiting_for_build_processing: false,
      distribute_external: true,
      groups: ["beta-testers"],
      changelog: options[:notes] || "Bug fixes and improvements"
    )
  end

  desc "Build and upload to App Store (for review)"
  lane :release do |options|
    # Increment build number
    increment_build_number(
      xcodeproj: "App.xcodeproj"
    )

    # Get the marketing version from the project
    version = get_version_number(
      xcodeproj: "App.xcodeproj",
      target: "App"
    )

    # Build the app
    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      clean: true
    )

    # Upload to App Store Connect
    upload_to_app_store(
      app_version: version,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false,
      force: true
    )
  end

  desc "Build, upload to App Store, and submit for review"
  lane :release_force do |options|
    # Increment build number
    increment_build_number(
      xcodeproj: "App.xcodeproj"
    )

    # Get the marketing version from the project
    version = get_version_number(
      xcodeproj: "App.xcodeproj",
      target: "App"
    )

    # Build the app
    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      clean: true,
      xcargs: "-allowProvisioningUpdates"
    )

    # Upload to App Store Connect and submit for review
    upload_to_app_store(
      app_version: version,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      # Precheck can't inspect in-app purchases through an API key, and fails
      # the whole submission if asked to. Zeeguu sells none.
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  desc "Upload the already-built App.ipa and submit for review (no rebuild)"
  lane :upload_and_submit do |options|
    # For when release_force built fine but the upload failed: reuse the ipa
    # instead of building (and bumping the build number) again. If the binary
    # did get uploaded and only the submission failed, pass skip_binary:true --
    # App Store Connect refuses the same build number twice.
    upload_to_app_store(
      ipa: "App.ipa",
      skip_binary_upload: options[:skip_binary] == true,
      app_version: get_version_number(xcodeproj: "App.xcodeproj", target: "App"),
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      # Precheck can't inspect in-app purchases through an API key, and fails
      # the whole submission if asked to. Zeeguu sells none.
      precheck_include_in_app_purchases: false,
      force: true
    )
  end

  desc "Just build the app (no upload)"
  lane :build do
    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      clean: true
    )
  end

end
